<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        Title="AURA" Width="808" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPriBrush}" KeyDown="Window_KeyDown">

    <!-- Окно всегда фиксированного размера и прозрачное (клики вне тела проходят насквозь).
         «Островок» — фигура Body, размер которой анимируется свойством Progress. -->
    <Grid>
        <!-- Тело островка/выреза: фигура пересчитывается в ApplyShape на каждом кадре пружины -->
        <Path x:Name="Body" Fill="{DynamicResource BgDeepBrush}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270"
                                  Opacity="0.34" Color="{DynamicResource AccentColor}" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost">

            <!-- ================= СВЁРНУТЫЙ ВИД: одна линия ================= -->

            <!-- Six Figma-defined compact layouts. The black Body is the only outer surface.
                 Actual Body sizes: 215x46, 231x46, 325x24, 325x24, 325x80, 325x80. -->
            <Grid x:Name="CollapsedView" Width="235" Height="46" Cursor="Hand"
                  Background="#01000000" ClipToBounds="True"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="IslandMenu">
                        <MenuItem Header="Развернуть" Click="Menu_Expand"/>
                        <MenuItem Header="Настройки" Click="Menu_Settings"/>
                        <Separator/>
                        <MenuItem Header="Выход" Click="Menu_Exit"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Base 215x46; seconds add exactly 16 to the clock group (231x46).
                     No dividing line. Fixed 20 DIP outer padding and section gaps. -->
                <Grid x:Name="CollapsedStack" Width="235" Height="46"
                      VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="CollapsedClockBlock" Grid.Column="1"
                          Height="24" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ClockText" Grid.Column="0" Text="22:06"
                                   FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="15"
                                   TextAlignment="Center" Typography.NumeralAlignment="Tabular"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Grid x:Name="ClockSecondsBlock" Grid.Column="1" Width="16" Height="24"
                              Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockSeconds" Text="03" FontFamily="Inter, Segoe UI"
                                       FontSize="8" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="3,1,0,0"/>
                        </Grid>
                    </Grid>

                    <!-- Drawing viewport includes 3 DIP of tracking room around 14x24 eyes. -->
                    <controls:CapsuleEyesControl x:Name="CompanionEyes" Grid.Column="0" Grid.ColumnSpan="7" Panel.ZIndex="2"
                                                  Width="60" Height="32"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  AccentBrush="{DynamicResource AccentBrush}"
                                                  ToolTip="AURA Companion"/>

                    <StackPanel x:Name="StatsPanel" Grid.Column="5" Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid x:Name="BatteryPanel" Width="50" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="BatteryIcon" Grid.Column="0"
                                  Style="{StaticResource VecIcon}"
                                  Width="20" Height="20"
                                  Data="{StaticResource ic_battery_full}"
                                  Fill="{DynamicResource TextSecBrush}"
                                  VerticalAlignment="Center"/>
                            <TextBlock x:Name="BatteryText" Grid.Column="1" Text="100%"
                                       FontFamily="Inter, Segoe UI" FontSize="8"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,3,0,0"
                                       Foreground="{DynamicResource TextPriBrush}"/>
                        </Grid>
                    </StackPanel>
                    <!-- Optional weather is reserved for the existing alternate game mode. -->
                    <StackPanel x:Name="CollapsedWeatherPanel" Grid.Column="5"
                                Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Path x:Name="CollapsedWeatherIcon" Style="{StaticResource VecIcon}"
                              Width="16" Height="16" Data="{StaticResource ic_cloud_sun}"
                              Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="CollapsedWeatherText" Text="--°" FontSize="12"
                                   Margin="5,0,0,0" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Volume: 325x24, static 4px accent fill, no slider/thumb. -->
                <Grid x:Name="VolumeIslandView" Width="325" Height="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="VolumeIslandIcon" Grid.Column="0"
                          Style="{StaticResource VecIcon}" Width="12" Height="12"
                          Data="{StaticResource ic_aura_volume}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="14,0,0,0" Fill="{DynamicResource TextSecBrush}"/>
                    <Grid x:Name="VolumeBarTrack" Grid.Column="1" Height="4"
                          Margin="3,0,6,0" VerticalAlignment="Center" ClipToBounds="True"
                          Background="{DynamicResource OverlayFaintBrush}">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,240,4" RadiusX="2" RadiusY="2"/>
                        </Grid.Clip>
                        <Border x:Name="VolumeBarFill" Height="4" Width="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <TextBlock x:Name="VolumeLevelText" Grid.Column="2" Text="0%"
                               FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource TextPriBrush}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Brightness: same visual structure and 325x24 dimensions. -->
                <Grid x:Name="BrightnessIslandView" Width="325" Height="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="54"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource VecIcon}"
                          Width="12" Height="12" Data="{StaticResource ic_sun}"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="14,0,0,0" Fill="{DynamicResource TextSecBrush}"/>
                    <Grid x:Name="BrightnessBarTrack" Grid.Column="1" Height="4"
                          Margin="3,0,6,0" VerticalAlignment="Center" ClipToBounds="True"
                          Background="{DynamicResource OverlayFaintBrush}">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,240,4" RadiusX="2" RadiusY="2"/>
                        </Grid.Clip>
                        <Border x:Name="BrightnessBarFill" Height="4" Width="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                    <TextBlock x:Name="BrightnessLevelText" Grid.Column="2" Text="0%"
                               FontFamily="Inter, Segoe UI" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource TextPriBrush}"
                               HorizontalAlignment="Right" Margin="0,0,14,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- State 4: 325x24 mini music strip. Headphone icon & vertical bars are
                     only visible when the selected Windows output is identified as headphones. -->
                <Grid x:Name="CollapsedTrackView" Width="325" Height="24" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="HeadphoneStatus" Grid.Column="0" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Path x:Name="TrackHeadphonesIcon" Style="{StaticResource VecIcon}"
                              Width="14" Height="14" Data="{StaticResource ic_headphones}"
                              Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Width="5" Height="14"
                                    Orientation="Vertical">
                            <Rectangle x:Name="HeadphoneVolumeHigh" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1" Margin="0,0,0,2"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                            <Rectangle x:Name="HeadphoneVolumeMid" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1" Margin="0,0,0,2"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                            <Rectangle x:Name="HeadphoneVolumeLow" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="TrackTextViewport" Grid.Column="1" ClipToBounds="True"
                          Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel x:Name="TrackTextStrip" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="CollapsedTrackTitle" FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <Border Width="28"/>
                            <TextBlock x:Name="RepeatedTrackTitle" FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TrackTextTransform"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Grid>
                    <!-- Legacy media visuals remain non-rendering for existing event handlers. -->
                    <Border x:Name="TrackCoverFrame" Visibility="Collapsed" Width="0" Height="0">
                        <Grid>
                            <Image x:Name="CollapsedTrackCover"/>
                            <Path x:Name="TrackCoverFallback" Style="{StaticResource VecIcon}"
                                  Data="{StaticResource ic_music}"/>
                        </Grid>
                    </Border>
                    <Canvas x:Name="TrackEqualizer" Visibility="Collapsed" Width="0" Height="0"/>
                </Grid>

                <!-- State 5: 325x80 reference track card; artwork 60x60, inset 12/10. -->
                <Grid x:Name="FullTrackCardView" Width="325" Height="80"
                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                    </Grid.ColumnDefinitions>
                    <!-- Use a RectangleGeometry clip: WPF Border.ClipToBounds alone does not
                         clip Image pixels to the rounded CornerRadius. -->
                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="10"
                            Margin="12,10,0,10" Background="{DynamicResource BgCardBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid Width="60" Height="60">
                            <Image x:Name="FullTrackArtwork" Stretch="UniformToFill"
                                   Width="60" Height="60">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,60,60" RadiusX="10" RadiusY="10"/>
                                </Image.Clip>
                            </Image>
                            <Path x:Name="FullTrackFallback" Width="22" Height="22"
                                  Style="{StaticResource VecIcon}" Data="{StaticResource ic_music}"
                                  Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Margin="0,11,0,11">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="FullTrackTitle" Grid.Row="0"
                                   FontFamily="Inter, Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPriBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="FullTrackArtist" Grid.Row="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="FullTrackAlbum" Grid.Row="1" FontSize="10"
                                   FontFamily="Inter, Segoe UI" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <Grid Grid.Row="2" VerticalAlignment="Bottom" Height="13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TrackCardPosition" Grid.Column="0" Text="00:00"
                                       FontFamily="Inter, Segoe UI" FontSize="9"
                                       Foreground="{DynamicResource TextPriBrush}" VerticalAlignment="Center"/>
                            <Grid x:Name="TrackCardProgressTrack" Grid.Column="1" Height="3"
                                  Margin="1,0,6,0" Background="{DynamicResource OverlayFaintBrush}"
                                  VerticalAlignment="Center" ClipToBounds="True">
                                <Border x:Name="TrackCardProgressFill" Width="0" Height="3"
                                        Background="{DynamicResource TextPriBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        CornerRadius="1.5"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Grid Grid.Column="2" Margin="3,10,8,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>
                        <Path x:Name="TrackCardHeadphones" Grid.Row="0"
                              Style="{StaticResource VecIcon}" Data="{StaticResource ic_aura_headphones}"
                              Fill="{DynamicResource TextPriBrush}" Width="18" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" ToolTip="Заряд батареи компьютера">
                            <Path x:Name="TrackCardBatteryIcon" Style="{StaticResource VecIcon}"
                                  Data="{StaticResource ic_aura_battery}" Width="17" Height="10"
                                  Fill="{DynamicResource TextPriBrush}"/>
                            <TextBlock x:Name="TrackCardBatteryPercent" FontSize="8" Margin="2,0,0,0"
                                       Foreground="{DynamicResource TextPriBrush}" VerticalAlignment="Center"
                                       Text="" />
                        </StackPanel>
                        <Path Grid.Row="2" Style="{StaticResource VecIcon}"
                              Data="{StaticResource ic_aura_bell}" Width="14" Height="14"
                              Fill="{DynamicResource TextPriBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="Уведомления Windows"/>
                    </Grid>
                </Grid>

                <!-- Optional original AURA style. Keep the user-selected version, not a third popup state. -->
                <Grid x:Name="ClassicTrackCardView" Width="325" Height="80"
                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="11"
                            Margin="8,0,0,0" Background="{DynamicResource BgCardBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="ClassicTrackArtwork" Width="64" Height="64"
                                   Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="11" RadiusY="11"/>
                                </Image.Clip>
                            </Image>
                            <Path x:Name="ClassicTrackFallback" Width="25" Height="25"
                                  Style="{StaticResource VecIcon}" Data="{StaticResource ic_music}"
                                  Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="2,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClassicTrackTitle" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPriBrush}"/>
                        <TextBlock x:Name="ClassicTrackArtist" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecBrush}"/>
                        <TextBlock x:Name="ClassicTrackAlbum" FontSize="10" Margin="0,3,0,0"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- State 6: 325x80 Windows notification. -->
                <Grid x:Name="NotificationIslandView" Width="325" Height="80"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                            Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}">
                        <Path Width="20" Height="20" Fill="{DynamicResource AccentBrush}"
                              Data="M12,22 C13.1,22 14,21.1 14,20 H10 C10,21.1 10.9,22 12,22 Z
                                    M18,16 V11 C18,7.9 16.4,5.3 13.5,4.6 V4 C13.5,3.2 12.8,2.5 12,2.5
                                    C11.2,2.5 10.5,3.2 10.5,4 V4.6 C7.6,5.3 6,7.9 6,11 V16
                                    L4,18 V19 H20 V18 Z"
                              Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationAppName" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="NotificationTitle" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPriBrush}"/>
                        <TextBlock x:Name="NotificationBody" FontSize="10" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxHeight="27"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= РАЗВЁРНУТЫЙ ВИД ================= -->
            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Background="#01000000"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка-навбар: вкладки-иконки слева, шестерёнка справа; единый боковой желоб 10 -->
                <Grid VerticalAlignment="Center" Margin="10,0,10,0">
                    <Grid x:Name="NavBar" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- аэро-плитка: единая подложка, плавно переезжающая к активной вкладке -->
                        <Border x:Name="NavPill" Height="38" Width="0" CornerRadius="19"
                                Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillMove"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="NavHome"    Style="{StaticResource NavToggle}" Tag="home"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Главная">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_house}"/>
                                <TextBlock Text="Главная" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavPlayer"  Style="{StaticResource NavToggle}" Tag="player"  Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Плеер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_music}"/>
                                <TextBlock Text="Плеер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavWeather" Style="{StaticResource NavToggle}" Tag="weather" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Погода">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_cloud_sun}"/>
                                <TextBlock Text="Погода" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavApps"    Style="{StaticResource NavToggle}" Tag="apps"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Лаунчер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_rocket}"/>
                                <TextBlock Text="Лаунчер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavAi"      Style="{StaticResource NavToggle}" Tag="ai"      Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="ИИ-чат">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_bot}"/>
                                <TextBlock Text="ИИ-чат" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavControl" Style="{StaticResource NavToggle}" Tag="control" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Система">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_sliders_horizontal}"/>
                                <TextBlock Text="Система" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Настройки" Click="Settings_Click">
                            <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_settings}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Экран остаётся чистым чёрным/белым; поверхности боксов используют отдельные кисти. -->
                <Border Grid.Row="1" Background="{DynamicResource BgDeepBrush}" CornerRadius="18"
                        Padding="10" Margin="10,0,10,12">
                    <ContentControl x:Name="PanelHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
