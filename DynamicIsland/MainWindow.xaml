<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        Title="AURA" Width="808" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="#F5F5F7" KeyDown="Window_KeyDown">

    <!-- Окно всегда фиксированного размера и прозрачное (клики вне тела проходят насквозь).
         «Островок» — фигура Body, размер которой анимируется свойством Progress. -->
    <Grid>
        <!-- Тело островка/выреза: фигура пересчитывается в ApplyShape на каждом кадре пружины -->
        <Path x:Name="Body" Fill="#F0000000"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Effect>
                <DropShadowEffect BlurRadius="7" ShadowDepth="2" Direction="270"
                                  Opacity="0.55" Color="#7C4DFF" RenderingBias="Quality"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentHostMove"/>
            </Grid.RenderTransform>

            <!-- ================= СВЁРНУТЫЙ ВИД: одна линия ================= -->
            <Grid x:Name="CollapsedView" Cursor="Hand" Margin="14,0" Background="#01000000"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  MouseLeftButtonDown="Island_Press" MouseMove="Island_Drag" MouseLeftButtonUp="Island_Release">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="IslandMenu">
                        <MenuItem Header="Развернуть" Click="Menu_Expand"/>
                        <MenuItem Header="Настройки" Click="Menu_Settings"/>
                        <Separator/>
                        <MenuItem Header="Выход" Click="Menu_Exit"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Одинаковые отступы: 14 px от краёв тела и между всеми элементами -->
                <StackPanel x:Name="CollapsedStack" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Часы слева -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="22:06" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ClockSeconds" Text=":03" FontSize="11" Foreground="{DynamicResource TextSecBrush}"
                                   VerticalAlignment="Bottom" Margin="1,0,0,2" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Компаньон по центру (компактный) -->
                    <controls:AtlasEyesControl x:Name="EyesCollapsed" Scale="0.95"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>

                    <!-- Батарея + статус-бар — единый блок справа -->
                    <StackPanel x:Name="StatsPanel" Orientation="Horizontal" Margin="14,0,0,0">
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="BatteryIcon" Style="{StaticResource VecIcon}" Width="15" Height="15"
                                  Data="{StaticResource ic_battery_full}" Fill="{DynamicResource TextSecBrush}"/>
                            <TextBlock x:Name="BatteryText" Text="100%" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecBrush}" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ================= РАЗВЁРНУТЫЙ ВИД ================= -->
            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Background="#01000000"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка-навбар: вкладки-иконки слева, шестерёнка справа; единый боковой желоб 10 -->
                <Grid VerticalAlignment="Center" Margin="10,0,10,0">
                    <Grid x:Name="NavBar" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- аэро-плитка: единая подложка, плавно переезжающая к активной вкладке -->
                        <Border x:Name="NavPill" Height="38" Width="0" CornerRadius="19"
                                Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillMove"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="NavHome"    Style="{StaticResource NavToggle}" Tag="home"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Главная">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_house}"/>
                                <TextBlock Text="Главная" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavPlayer"  Style="{StaticResource NavToggle}" Tag="player"  Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Плеер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_music}"/>
                                <TextBlock Text="Плеер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavWeather" Style="{StaticResource NavToggle}" Tag="weather" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Погода">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_cloud_sun}"/>
                                <TextBlock Text="Погода" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavApps"    Style="{StaticResource NavToggle}" Tag="apps"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Лаунчер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_rocket}"/>
                                <TextBlock Text="Лаунчер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavAi"      Style="{StaticResource NavToggle}" Tag="ai"      Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="ИИ-чат">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_bot}"/>
                                <TextBlock Text="ИИ-чат" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavControl" Style="{StaticResource NavToggle}" Tag="control" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Система">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_sliders_horizontal}"/>
                                <TextBlock Text="Система" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Настройки" Click="Settings_Click">
                            <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_settings}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Контент панели: тематичный оттенок акцента, тот же желоб 10 -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanelTintBrush}" CornerRadius="18"
                        Padding="10" Margin="10,0,10,12">
                    <ContentControl x:Name="PanelHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
