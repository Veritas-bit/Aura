<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DynamicIsland.Controls"
        Title="AURA" Width="808" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPriBrush}" KeyDown="Window_KeyDown">

    <!-- Окно всегда фиксированного размера и прозрачное (клики вне тела проходят насквозь).
         «Островок» — фигура Body, размер которой анимируется свойством Progress. -->
    <Grid>
        <!-- Тело островка/выреза: фигура пересчитывается в ApplyShape на каждом кадре пружины -->
        <Path x:Name="Body" Fill="{DynamicResource BgDeepBrush}"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270"
                                  Opacity="0.34" Color="{DynamicResource AccentColor}" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Grid x:Name="ContentHost">

            <!-- ================= СВЁРНУТЫЙ ВИД: одна линия ================= -->

            <!-- Six Figma-defined compact layouts. The black Body is the only outer surface.
                 Actual Body sizes: 215x46, 231x46, 325x24, 325x24, 325x80, 325x80. -->
            <Grid x:Name="CollapsedView" Width="215" Height="46" Cursor="Hand"
                  Background="#01000000" ClipToBounds="True"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ContextMenu>
                    <ContextMenu x:Name="IslandMenu">
                        <MenuItem Header="Развернуть" Click="Menu_Expand"/>
                        <MenuItem Header="Настройки" Click="Menu_Settings"/>
                        <Separator/>
                        <MenuItem Header="Выход" Click="Menu_Exit"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- State 1/2: clock, optional 16 DIP seconds, capsule eyes, battery. -->
                <Grid x:Name="CollapsedStack" Width="215" Height="46" VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="CollapsedClockBlock" Grid.Column="0" Orientation="Horizontal"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="22:06" Width="48" FontFamily="Consolas"
                                   FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        <Border x:Name="ClockSecondsBlock" Width="16" Height="18" CornerRadius="5"
                                Background="{DynamicResource BgCardBrush}" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ClockSeconds" Text="03" FontFamily="Consolas" FontSize="9"
                                       Foreground="{DynamicResource TextSecBrush}" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <Border x:Name="ClockDivider" Grid.Column="1" Width="1" Height="22"
                            Background="{DynamicResource BorderSoftBrush}"
                            Margin="12,0,11,0" VerticalAlignment="Center"/>
                    <controls:CapsuleEyesControl x:Name="CompanionEyes" Grid.Column="2"
                                                  Width="30" Height="22"
                                                  AccentBrush="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center" ToolTip="AURA Companion"/>
                    <StackPanel x:Name="StatsPanel" Grid.Column="4" Orientation="Horizontal"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="BatteryIcon" Style="{StaticResource VecIcon}" Width="15" Height="15"
                                  Data="{StaticResource ic_battery_full}" Fill="{DynamicResource TextSecBrush}"/>
                            <TextBlock x:Name="BatteryText" Text="100%" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecBrush}"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Kept for weather/game-mode settings; not displayed in the six fixed-size layouts. -->
                    <StackPanel x:Name="CollapsedWeatherPanel" Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Path x:Name="CollapsedWeatherIcon" Style="{StaticResource VecIcon}"
                              Width="16" Height="16" Data="{StaticResource ic_cloud_sun}"
                              Fill="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="CollapsedWeatherText" Text="--°" FontSize="12" Margin="5,0,0,0"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- State 3: 325x24, interactive volume slider, not a 62px generic notification. -->
                <Grid x:Name="VolumeIslandView" Width="325" Height="24" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="51"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Style="{StaticResource VecIcon}" Width="14" Height="14"
                          Data="{StaticResource ic_volume_2}" Fill="{DynamicResource TextSecBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Slider x:Name="IslandVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                            Height="18" Margin="0,0,7,0" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" Cursor="Arrow" ToolTip="Громкость Windows"
                            ValueChanged="IslandVolumeSlider_ValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="{x:Type Slider}">
                                <Grid Background="#01000000">
                                    <Track x:Name="PART_Track" Height="14" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                          Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                                Background="{DynamicResource AccentBrush}"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="7" Height="14">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Width="7" Height="14" CornerRadius="3.5"
                                                                Background="{DynamicResource TextPriBrush}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                          Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                                Background="{DynamicResource OverlayFaintBrush}"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <TextBlock x:Name="VolumeLevelText" Grid.Column="2" Text="50%" FontSize="11"
                               Foreground="{DynamicResource TextPriBrush}" FontFamily="Consolas"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- State 4: 325x24 mini music strip. Headphone icon & vertical bars are
                     only visible when the selected Windows output is identified as headphones. -->
                <Grid x:Name="CollapsedTrackView" Width="325" Height="24" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="HeadphoneStatus" Grid.Column="0" Orientation="Horizontal"
                                Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <Path x:Name="TrackHeadphonesIcon" Style="{StaticResource VecIcon}"
                              Width="14" Height="14" Data="{StaticResource ic_headphones}"
                              Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center" Width="5" Height="14"
                                    Orientation="Vertical">
                            <Rectangle x:Name="HeadphoneVolumeHigh" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1" Margin="0,0,0,2"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                            <Rectangle x:Name="HeadphoneVolumeMid" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1" Margin="0,0,0,2"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                            <Rectangle x:Name="HeadphoneVolumeLow" Width="4" Height="3"
                                       RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource AccentBrush}" Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="TrackTextViewport" Grid.Column="1" ClipToBounds="True"
                          Margin="12,0,12,0" VerticalAlignment="Center">
                        <StackPanel x:Name="TrackTextStrip" Orientation="Horizontal" VerticalAlignment="Center"
                                    HorizontalAlignment="Left">
                            <TextBlock x:Name="CollapsedTrackTitle" FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <Border Width="28"/>
                            <TextBlock x:Name="RepeatedTrackTitle" FontSize="11" FontWeight="SemiBold"
                                       TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="TrackTextTransform"/>
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Grid>
                    <!-- Legacy media visuals remain non-rendering for existing event handlers. -->
                    <Border x:Name="TrackCoverFrame" Visibility="Collapsed" Width="0" Height="0">
                        <Grid>
                            <Image x:Name="CollapsedTrackCover"/>
                            <Path x:Name="TrackCoverFallback" Style="{StaticResource VecIcon}"
                                  Data="{StaticResource ic_music}"/>
                        </Grid>
                    </Border>
                    <Canvas x:Name="TrackEqualizer" Visibility="Collapsed" Width="0" Height="0"/>
                </Grid>

                <!-- State 5: 325x80 track card, on track change, then mini player. -->
                <Grid x:Name="FullTrackCardView" Width="325" Height="80" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="11" Margin="8,0,0,0"
                            Background="{DynamicResource BgCardBrush}" ClipToBounds="True"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="FullTrackArtwork" Stretch="UniformToFill"/>
                            <Path x:Name="FullTrackFallback" Width="25" Height="25"
                                  Style="{StaticResource VecIcon}" Data="{StaticResource ic_music}"
                                  Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="2,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FullTrackTitle" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPriBrush}"/>
                        <TextBlock x:Name="FullTrackArtist" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecBrush}"/>
                        <TextBlock x:Name="FullTrackAlbum" FontSize="10" Margin="0,3,0,0"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- State 6: 325x80 Windows notification. -->
                <Grid x:Name="NotificationIslandView" Width="325" Height="80"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="12"
                            Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource AccentSoftBrush}">
                        <Path Width="20" Height="20" Fill="{DynamicResource AccentBrush}"
                              Data="M12,22 C13.1,22 14,21.1 14,20 H10 C10,21.1 10.9,22 12,22 Z
                                    M18,16 V11 C18,7.9 16.4,5.3 13.5,4.6 V4 C13.5,3.2 12.8,2.5 12,2.5
                                    C11.2,2.5 10.5,3.2 10.5,4 V4.6 C7.6,5.3 6,7.9 6,11 V16
                                    L4,18 V19 H20 V18 Z"
                              Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NotificationAppName" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock x:Name="NotificationTitle" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPriBrush}"/>
                        <TextBlock x:Name="NotificationBody" FontSize="10" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxHeight="27"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= РАЗВЁРНУТЫЙ ВИД ================= -->
            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Background="#01000000"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка-навбар: вкладки-иконки слева, шестерёнка справа; единый боковой желоб 10 -->
                <Grid VerticalAlignment="Center" Margin="10,0,10,0">
                    <Grid x:Name="NavBar" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- аэро-плитка: единая подложка, плавно переезжающая к активной вкладке -->
                        <Border x:Name="NavPill" Height="38" Width="0" CornerRadius="19"
                                Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavPillMove"/>
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="NavHome"    Style="{StaticResource NavToggle}" Tag="home"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Главная">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_house}"/>
                                <TextBlock Text="Главная" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavPlayer"  Style="{StaticResource NavToggle}" Tag="player"  Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Плеер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_music}"/>
                                <TextBlock Text="Плеер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavWeather" Style="{StaticResource NavToggle}" Tag="weather" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Погода">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_cloud_sun}"/>
                                <TextBlock Text="Погода" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavApps"    Style="{StaticResource NavToggle}" Tag="apps"    Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Лаунчер">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_rocket}"/>
                                <TextBlock Text="Лаунчер" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavAi"      Style="{StaticResource NavToggle}" Tag="ai"      Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="ИИ-чат">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_bot}"/>
                                <TextBlock Text="ИИ-чат" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="NavControl" Style="{StaticResource NavToggle}" Tag="control" Checked="Nav_Checked" Unchecked="Nav_Unchecked" ToolTip="Система">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_sliders_horizontal}"/>
                                <TextBlock Text="Система" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,2,0"
                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Настройки" Click="Settings_Click">
                            <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_settings}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Экран остаётся чистым чёрным/белым; поверхности боксов используют отдельные кисти. -->
                <Border Grid.Row="1" Background="{DynamicResource BgDeepBrush}" CornerRadius="18"
                        Padding="10" Margin="10,0,10,12">
                    <ContentControl x:Name="PanelHost"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
