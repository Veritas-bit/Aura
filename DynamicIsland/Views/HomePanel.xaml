<UserControl x:Class="DynamicIsland.Views.HomePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="HomeToolTile" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" Background="{TemplateBinding Background}"
                                CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,10"/>

        <!-- Инструменты быстрого доступа -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="18"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="3">
        <UniformGrid Columns="4" Rows="2">
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_ScreenRecord">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_circle_dot}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Запись экрана" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Screenshot">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_camera}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Скриншот" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Notes">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_notebook_pen}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Заметки" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Alarm">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_alarm_clock}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Будильник" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Calculator">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_calculator}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Калькулятор" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Timer">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_timer}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Таймер" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Clipboard">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_clipboard}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Буфер обмена" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
            <Button Style="{StaticResource HomeToolTile}" Margin="4" Click="Tool_Explorer">
                <StackPanel><Path Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_folder}" Fill="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center"/><TextBlock Text="Проводник" FontSize="12" Foreground="{DynamicResource AccentOnBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel>
            </Button>
        </UniformGrid>
        </Border>

        <!-- Встроенный инструмент -->
        <Border x:Name="ToolHost" Grid.Row="2" Margin="4,8,4,0" Background="{DynamicResource BgCardBrush}"
                CornerRadius="14" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                Padding="12" Visibility="Collapsed">
            <Grid>

            <!-- Заметки -->
            <Grid x:Name="NotesTool" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_notebook_pen}" Margin="0,0,6,0"/>
                        <TextBlock Text="Заметки — сохраняются автоматически" FontSize="13" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Click="CloseTool"/>
                </Grid>
                <TextBox x:Name="NotesBox" Grid.Row="1" Margin="0,8,0,0" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Notes_Changed"/>
            </Grid>

            <!-- Будильник -->
            <Grid x:Name="AlarmTool" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_alarm_clock}" Margin="0,0,6,0"/>
                        <TextBlock Text="Будильник" FontSize="13" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Click="CloseTool"/>
                </Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="AlarmTimeBox" Text="07:30" Width="120" FontSize="23" HorizontalContentAlignment="Center"/>
                    <TextBlock Text="формат ЧЧ:мм" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ChipButton}" Content="Установить" Click="Alarm_Set"/>
                        <Button Style="{StaticResource ChipButton}" Content="Отменить" Margin="8,0,0,0" Click="Alarm_Cancel"/>
                    </StackPanel>
                    <TextBlock x:Name="AlarmStatus" Text="" FontSize="12" Foreground="{DynamicResource TextSecBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Калькулятор -->
            <Grid x:Name="CalcTool" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_calculator}" Margin="0,0,6,0"/>
                        <TextBlock Text="Калькулятор" FontSize="13" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Click="CloseTool"/>
                </Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="CalcInput" Width="260" FontSize="19" KeyDown="Calc_KeyDown"/>
                    <TextBlock x:Name="CalcResult" Text="=" FontSize="23" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="Enter — посчитать. Например: (12+34)*2/3" FontSize="11"
                               Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Таймер -->
            <Grid x:Name="TimerTool" Visibility="Collapsed">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_timer}" Margin="0,0,6,0"/>
                        <TextBlock Text="Таймер" FontSize="13" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right" Click="CloseTool"/>
                </Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerDisplay" Text="05:00" FontSize="35" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBox x:Name="TimerMinutesBox" Text="5" Width="60" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="мин" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource TextSecBrush}"/>
                        <Button Style="{StaticResource ChipButton}" Content="Старт" Click="Timer_Start"/>
                        <Button Style="{StaticResource ChipButton}" Content="Стоп" Margin="8,0,0,0" Click="Timer_Stop"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
