<UserControl x:Class="DynamicIsland.Views.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="QuickTile" TargetType="Button" BasedOn="{StaticResource TileButton}">
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
        <Style x:Key="QuickIconChip" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource OverlayFaintBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ПОДКЛЮЧЕНИЯ" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecBrush}" Margin="6,0,0,2"/>
            <UniformGrid Columns="6">
                <Button x:Name="WifiTile" Style="{StaticResource QuickTile}" Click="Wifi_Click" ToolTip="Вкл/выкл Wi-Fi">
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="WifiChip" Style="{StaticResource QuickIconChip}">
                            <Path x:Name="WifiIcon" Style="{StaticResource VecIcon}" Width="14" Height="14"
                                  Data="{StaticResource ic_wifi}" Fill="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBlock Text="Wi-Fi" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="WifiStatus" Text="—" FontSize="8.5"
                                   Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtTile" Style="{StaticResource QuickTile}" Click="Bt_Click" ToolTip="Вкл/выкл Bluetooth">
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="BtChip" Style="{StaticResource QuickIconChip}">
                            <Path x:Name="BtIcon" Style="{StaticResource VecIcon}" Width="14" Height="14"
                                  Data="{StaticResource ic_bluetooth}" Fill="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBlock Text="Bluetooth" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="BtStatus" Text="—" FontSize="8.5"
                                   Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="Vpn_Click" Tag="ms-settings:network-vpn">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_shield}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="VPN" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:network-airplanemode">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_radio_tower}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Режим полёта" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:network-mobilehotspot">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_wifi}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Точка доступа" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:network-proxy">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_settings}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Прокси" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,5,0,0">
            <TextBlock Text="ЭКРАН И ФОКУС" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecBrush}" Margin="6,0,0,2"/>
            <UniformGrid Columns="6">
                <Button x:Name="ThemeTile" Style="{StaticResource QuickTile}" Click="Theme_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="ThemeChip" Style="{StaticResource QuickIconChip}">
                            <Path x:Name="ThemeIcon" Style="{StaticResource VecIcon}" Width="14" Height="14"
                                  Data="{StaticResource ic_moon}" Fill="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBlock Text="Тёмная тема" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="ThemeStatus" Text="—" FontSize="8.5"
                                   Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:nightlight">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_sun}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Ночной свет" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:display">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_sliders_horizontal}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Дисплей" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:notifications">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_radio_tower}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Уведомления" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:quiethours">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_moon}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Фокус" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:easeofaccess">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_keyboard}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Спец. возможности" FontSize="8.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5,0,0">
            <TextBlock Text="СИСТЕМА" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecBrush}" Margin="6,0,0,2"/>
            <UniformGrid Columns="6">
                <Button Style="{StaticResource QuickTile}" Click="Battery_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Border x:Name="BatteryChip" Style="{StaticResource QuickIconChip}">
                            <Path x:Name="BatteryIcon" Style="{StaticResource VecIcon}" Width="14" Height="14"
                                  Data="{StaticResource ic_battery_full}" Fill="{DynamicResource TextDimBrush}"/>
                        </Border>
                        <TextBlock Text="Батарея" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock x:Name="BatteryStatus" Text="—" FontSize="8.5"
                                   Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:sound">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_volume_2}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Звук" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:clipboard">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_clipboard}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Буфер обмена" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:startupapps">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_rocket}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Автозагрузка" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:windowsupdate">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_rotate_ccw}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Обновление" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource QuickTile}" Click="SettingsShortcut_Click" Tag="ms-settings:">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="17" Height="17" Data="{StaticResource ic_settings}"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="Параметры" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="ГРОМКОСТЬ И ЯРКОСТЬ" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecBrush}" Margin="6,8,0,2"/>
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="16" Margin="3"
                    Padding="14,7" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="MuteIcon" Style="{StaticResource VecIcon}" Width="16" Height="16"
                              Data="{StaticResource ic_volume_2}" VerticalAlignment="Center" Cursor="Hand"
                              MouseLeftButtonUp="Mute_Click" ToolTip="Вкл/выкл звук"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" ValueChanged="Volume_Changed"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="50%" FontSize="12"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_sun}"
                              VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" ValueChanged="Brightness_Changed"/>
                        <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="" FontSize="12"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,2">
            <TextBlock Text="ПИТАНИЕ" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecBrush}" Margin="6,7,0,2"/>
            <UniformGrid Columns="6">
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="Lock_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_lock}" VerticalAlignment="Center"/>
                        <TextBlock Text="Блокировка" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="Sleep_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_moon}" VerticalAlignment="Center"/>
                        <TextBlock Text="Сон" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="Restart_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_rotate_ccw}" VerticalAlignment="Center"/>
                        <TextBlock Text="Перезагрузка" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="Shutdown_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_power}" VerticalAlignment="Center"/>
                        <TextBlock Text="Выключение" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="LogOff_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_log_out}" VerticalAlignment="Center"/>
                        <TextBlock Text="Выход" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="38" Margin="3" Padding="5,2" Click="TaskMgr_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_clipboard_list}" VerticalAlignment="Center"/>
                        <TextBlock Text="Диспетчер задач" FontSize="8.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
