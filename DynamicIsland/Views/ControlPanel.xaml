<UserControl x:Class="DynamicIsland.Views.ControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Круглый чип иконки внутри крупной плитки -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- Маленькая кнопка-шестерёнка «≡» в углу плитки -->
        <Style x:Key="TileMiniButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel>

            <!-- Переключатели системы: крупные плитки с круглыми чипами -->
            <UniformGrid Columns="5">

                <Button x:Name="WifiTile" Style="{StaticResource TileButton}" Height="96" Margin="4" Click="Wifi_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border x:Name="WifiChip" Style="{StaticResource IconChip}">
                                <Path x:Name="WifiIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                      Data="{StaticResource ic_wifi}" Fill="{DynamicResource TextDimBrush}"/>
                            </Border>
                            <Button Style="{StaticResource TileMiniButton}" ToolTip="Параметры Wi-Fi" Click="WifiSettings_Click">
                                <Path Style="{StaticResource VecIcon}" Width="11" Height="11"
                                      Data="{StaticResource ic_settings}" Fill="{DynamicResource TextDimBrush}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="Wi-Fi" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WifiStatus" Text="—" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="BtTile" Style="{StaticResource TileButton}" Height="96" Margin="4" Click="Bt_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border x:Name="BtChip" Style="{StaticResource IconChip}">
                                <Path x:Name="BtIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                      Data="{StaticResource ic_bluetooth}" Fill="{DynamicResource TextDimBrush}"/>
                            </Border>
                            <Button Style="{StaticResource TileMiniButton}" ToolTip="Параметры Bluetooth" Click="BtSettings_Click">
                                <Path Style="{StaticResource VecIcon}" Width="11" Height="11"
                                      Data="{StaticResource ic_settings}" Fill="{DynamicResource TextDimBrush}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="Bluetooth" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BtStatus" Text="—" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="VpnTile" Style="{StaticResource TileButton}" Height="96" Margin="4" Click="Vpn_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border x:Name="VpnChip" Style="{StaticResource IconChip}">
                                <Path x:Name="VpnIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                      Data="{StaticResource ic_shield}" Fill="{DynamicResource TextDimBrush}"/>
                            </Border>
                            <Button Style="{StaticResource TileMiniButton}" ToolTip="Параметры VPN" Click="VpnSettings_Click">
                                <Path Style="{StaticResource VecIcon}" Width="11" Height="11"
                                      Data="{StaticResource ic_settings}" Fill="{DynamicResource TextDimBrush}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="VPN" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VpnStatus" Text="Выключен" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button x:Name="ThemeTile" Style="{StaticResource TileButton}" Height="96" Margin="4" Click="Theme_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border x:Name="ThemeChip" Style="{StaticResource IconChip}">
                                <Path x:Name="ThemeIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                      Data="{StaticResource ic_moon}" Fill="{DynamicResource TextDimBrush}"/>
                            </Border>
                            <Button Style="{StaticResource TileMiniButton}" ToolTip="Персонализация" Click="ThemeSettings_Click">
                                <Path Style="{StaticResource VecIcon}" Width="11" Height="11"
                                      Data="{StaticResource ic_settings}" Fill="{DynamicResource TextDimBrush}"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="Тёмная тема" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ThemeStatus" Text="—" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Style="{StaticResource TileButton}" Height="96" Margin="4" Click="Battery_Click">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border x:Name="BatteryChip" Style="{StaticResource IconChip}">
                                <Path x:Name="BatteryIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                      Data="{StaticResource ic_battery_full}" Fill="{DynamicResource TextDimBrush}"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock Text="Батарея" FontSize="13.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BatteryStatus" Text="—" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Ползунки -->
            <TextBlock Text="Громкость и яркость" FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="6,14,0,6"/>
            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="16" Margin="4" Padding="14,10"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Path x:Name="MuteIcon" Style="{StaticResource VecIcon}" Width="16" Height="16"
                              Data="{StaticResource ic_volume_2}" VerticalAlignment="Center" Cursor="Hand"
                              MouseLeftButtonUp="Mute_Click" ToolTip="Вкл/выкл звук"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" ValueChanged="Volume_Changed"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="50%" FontSize="12"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource VecIcon}" Width="16" Height="16"
                              Data="{StaticResource ic_sun}" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" ValueChanged="Brightness_Changed"/>
                        <TextBlock x:Name="BrightnessText" Grid.Column="2" Text="" FontSize="12"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Быстрые действия: мелкие плитки -->
            <TextBlock Text="Питание и система" FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="6,14,0,6"/>
            <UniformGrid Columns="4">
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="Lock_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_lock}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Блокировка" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="Sleep_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_moon}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Сон" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="Restart_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_rotate_ccw}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Перезагрузка" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="Shutdown_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_power}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выключение" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="LogOff_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_log_out}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Выйти из сеанса" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TileButton}" Height="66" Margin="4" Click="TaskMgr_Click">
                    <StackPanel VerticalAlignment="Center">
                        <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_clipboard_list}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Диспетчер задач" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
