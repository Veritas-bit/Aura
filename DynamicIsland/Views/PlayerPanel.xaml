<UserControl x:Class="DynamicIsland.Views.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BgPopupBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPriBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,0,0,12">
            <StackPanel>
                <TextBlock Text="СЕЙЧАС ИГРАЕТ" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock x:Name="SessionStatus" Text="Ищем активный плеер…" FontSize="11"
                           Foreground="{DynamicResource TextSecBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <ComboBox x:Name="SourceSelector" HorizontalAlignment="Right" VerticalAlignment="Center"
                      MinWidth="120" MaxWidth="190" Padding="8,4"
                      Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPriBrush}"
                      BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                      DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Source_Changed"
                      ToolTip="Выбрать медиаплеер" Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" CornerRadius="22"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Padding="22"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="ArtworkBackdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.13"
                       IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="38"/>
                    </Image.Effect>
                </Image>
                <Border Grid.ColumnSpan="2" Background="{DynamicResource BgCardBrush}" Opacity="0.72"/>
                <Border Width="260" Height="260" CornerRadius="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ClipToBounds="True" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        Background="{DynamicResource BgDeepBrush}">
                    <Grid>
                        <Image x:Name="TrackCover" Stretch="UniformToFill" Visibility="Collapsed"/>
                        <Grid x:Name="CoverFallback">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentSecondaryColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentTertiaryColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <Ellipse Width="210" Height="210" Stroke="{DynamicResource AccentTertiaryBrush}" StrokeThickness="1"
                                     Opacity="0.2"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-70,0"/>
                            <Ellipse Width="150" Height="150" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                     Opacity="0.18"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,-40,0"/>
                            <Path Style="{StaticResource VecIcon}" Width="56" Height="56"
                                  Data="{StaticResource ic_music}" Fill="{DynamicResource AccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="28,4,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TrackTitle" Text="Запустите музыку в любом приложении"
                                   FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TrackArtist" Text="AURA покажет текущий трек и синхронизирует управление"
                                   FontSize="15" Foreground="{DynamicResource TextSecBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimeCurrent" Text="0:00" FontSize="11"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="SeekSlider" Grid.Column="1" ValueChanged="Seek_Changed"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="0:00" FontSize="11"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="Prev_Click" Margin="0,0,12,0"
                                ToolTip="Предыдущий трек">
                            <Path Style="{StaticResource VecIcon}" Width="18" Height="18"
                                  Data="{StaticResource ic_skip_back}"/>
                        </Button>
                        <Button x:Name="PlayButton" Style="{StaticResource IconButton}" MinWidth="52" MinHeight="52"
                                Background="{DynamicResource AccentSoftBrush}" Click="PlayPause_Click">
                            <Path x:Name="PlayIcon" Style="{StaticResource VecIcon}" Width="23" Height="23"
                                  Data="{StaticResource ic_play}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Next_Click" Margin="12,0,0,0"
                                ToolTip="Следующий трек">
                            <Path Style="{StaticResource VecIcon}" Width="18" Height="18"
                                  Data="{StaticResource ic_skip_forward}"/>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="8,14,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" MinWidth="32" MinHeight="32"
                                Click="Mute_Click" ToolTip="Включить/выключить звук">
                            <Path x:Name="VolumeIcon" Style="{StaticResource VecIcon}" Width="17" Height="17"
                                  Data="{StaticResource ic_volume_2}"/>
                        </Button>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                ValueChanged="Volume_Changed" VerticalAlignment="Center" Margin="10,0"
                                ToolTip="Системная громкость Windows"/>
                        <TextBlock x:Name="VolumeText" Grid.Column="2" Text="—%" FontSize="11"
                                   Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
