<UserControl x:Class="DynamicIsland.Views.PlayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynamicIsland.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Слева (2/3): обложка под персонажа, трек, сикбар, транспорт, громкость — строго по строкам -->
        <StackPanel Margin="0,0,14,0" VerticalAlignment="Top">

            <!-- Обложка: глаза Ауры на акцентном фоне -->
            <Border Width="150" Height="150" CornerRadius="22" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentSoftBrush}">
                <Border CornerRadius="22">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#22FFFFFF" Offset="0"/>
                            <GradientStop Color="#05FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <controls:AtlasEyesControl x:Name="CoverEyes" Scale="2.0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource VecIcon}" Width="15" Height="15" Data="{StaticResource ic_music}"
                              Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,14,14,0" Opacity="0.8"/>
                    </Grid>
                </Border>
            </Border>

            <TextBlock x:Name="TrackTitle" Text="Ничего не играет" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
            <TextBlock x:Name="TrackPath" Text="Добавьте треки в плейлист" FontSize="11.5"
                       Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>

            <!-- Позиция -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeCurrent" Text="0:00" FontSize="11" Foreground="{DynamicResource TextSecBrush}"
                           VerticalAlignment="Center"/>
                <Slider x:Name="SeekSlider" Grid.Column="1" ValueChanged="Seek_Changed" Maximum="100"
                        VerticalAlignment="Center"/>
                <TextBlock x:Name="TimeTotal" Grid.Column="2" Text="0:00" FontSize="11"
                           Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Транспорт -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Click="Shuffle_Click" ToolTip="Случайный порядок">
                    <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_shuffle}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Prev_Click">
                    <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_skip_back}"/>
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" MinWidth="44" MinHeight="44" Click="PlayPause_Click">
                    <Path x:Name="PlayIcon" Style="{StaticResource VecIcon}" Width="22" Height="22" Data="{StaticResource ic_play}"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="Next_Click">
                    <Path Style="{StaticResource VecIcon}" Width="18" Height="18" Data="{StaticResource ic_skip_forward}"/>
                </Button>
                <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Click="Repeat_Click" ToolTip="Повтор">
                    <Path Style="{StaticResource VecIcon}" Width="16" Height="16" Data="{StaticResource ic_repeat}"/>
                </Button>
            </StackPanel>

            <!-- Громкость — отдельной строкой под транспортом -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Path Style="{StaticResource VecIcon}" Width="14" Height="14" Data="{StaticResource ic_volume_2}"
                      VerticalAlignment="Center" Fill="{DynamicResource TextSecBrush}"/>
                <Slider x:Name="VolumeSlider" Width="120" ValueChanged="Volume_Changed" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Справа: плейлист -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Плейлист" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <ListBox x:Name="PlaylistBox" Grid.Row="1" MouseDoubleClick="Playlist_DoubleClick"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource ChipButton}" Content="＋ Добавить" Click="Add_Click"/>
                <Button Style="{StaticResource ChipButton}" Content="－" Margin="6,0,0,0" Click="Remove_Click" ToolTip="Убрать выбранный трек"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
