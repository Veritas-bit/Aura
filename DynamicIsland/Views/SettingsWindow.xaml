<Window x:Class="DynamicIsland.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        Title="AURA — настройки" Width="860" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextPriBrush}" KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_Drag">

    <Border x:Name="WindowSurface" CornerRadius="16" Background="{DynamicResource BgWindowBrush}" Margin="6"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Крестик закрытия: жирный X с круглыми концами в акцентном цвете -->
            <Button Grid.ColumnSpan="2" Panel.ZIndex="5" Width="56" Height="56"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                    Click="Close_Click" ToolTip="Закрыть" Cursor="Hand"
                    Background="Transparent" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path x:Name="Cross" Data="M3.2,3.2 L12.8,12.8 M12.8,3.2 L3.2,12.8"
                                  Stroke="{DynamicResource TextSecBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="16" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cross" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cross" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ===== Сайдбар ===== -->
            <Border Background="{DynamicResource BgSidebarBrush}" CornerRadius="16,0,0,16"
                    BorderBrush="{DynamicResource OverlayFaintBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="16,18,12,10">
                        <TextBlock Text="AURA" FontSize="18" FontWeight="Bold" Margin="2,0,0,0"/>
                        <TextBlock x:Name="VersionLabel" Text="Версия 0.0.1" FontSize="12.5"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="2,3,0,0"/>
                    </StackPanel>

                    <StackPanel x:Name="NavPanel" Grid.Row="1" Margin="8,2"/>

                    <StackPanel Grid.Row="2" Margin="16,8,16,14">
                        <TextBlock Text="Изменения сохраняются сразу" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}" Margin="2,0,0,8"/>
                        <Button Style="{StaticResource ChipButton}" HorizontalContentAlignment="Left" Click="Exit_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource VecIcon}" Width="13" Height="13"
                                      Data="{StaticResource ic_power}" Fill="{DynamicResource AccentTertiaryBrush}"/>
                                <TextBlock Text="Выйти из AURA" FontSize="13.5" Margin="8,0,0,0"
                                           Foreground="{DynamicResource AccentTertiaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Контент ===== -->
            <Grid Grid.Column="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="22,0,22,0">
                    <TextBlock x:Name="PageTitle" Text="Внешний вид" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="22,0,22,16">

                    <Grid>
                        <!-- ======== Темы ======== -->
                        <StackPanel x:Name="PageThemes">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="16" Padding="18"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Тихая эстетика. Ясный фокус." FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Строгий чёрный или белый фон, контрастный текст и три акцента. Выберите готовую палитру или задайте собственные цвета."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecBrush}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Цветовая тема" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Готовые темы задают три акцентных цвета и базовую тему."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,12"/>
                                    <WrapPanel x:Name="ThemeCardsHost"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Авто и Системная" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="«Системная» подхватывает акцентный цвет Windows (панель задач, переключатели, рамки окон) и обновляется при его смене. «Авто» переключает Утреннюю / Дневную / Вечернюю / Ночную по времени суток: 5–9, 9–17, 17–21 и 21–5."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Контрастная палитра" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Изменение любого значения переводит тему в пользовательский режим. Цвета указываются в формате HEX и автоматически корректируются для контраста 4,5:1."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecBrush}"
                                               Margin="0,4,0,10"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <RadioButton x:Name="BlackBackground" Content="Чёрный фон" GroupName="BackgroundMode"
                                                     Foreground="{DynamicResource TextPriBrush}" Checked="BackgroundMode_Changed"/>
                                        <RadioButton x:Name="WhiteBackground" Content="Белый фон" GroupName="BackgroundMode"
                                                     Foreground="{DynamicResource TextPriBrush}" Margin="18,0,0,0"
                                                     Checked="BackgroundMode_Changed"/>
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Акцент 1" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                                            <TextBox x:Name="PrimaryAccentBox" Margin="0,4,0,0" LostFocus="AccentColor_LostFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0">
                                            <TextBlock Text="Акцент 2" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                                            <TextBox x:Name="SecondaryAccentBox" Margin="0,4,0,0" LostFocus="AccentColor_LostFocus"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                            <TextBlock Text="Акцент 3" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                                            <TextBox x:Name="TertiaryAccentBox" Margin="0,4,0,0" LostFocus="AccentColor_LostFocus"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ======== Общее ======== -->
                        <StackPanel x:Name="PageGeneral" Visibility="Collapsed">

                            <TextBlock Text="Свёрнутый вид" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="StyleIsland" Content="Островок (плавающий)" GroupName="StyleMode"
                                                 Foreground="{DynamicResource TextPriBrush}" FontSize="13" Checked="Style_Changed"/>
                                    <RadioButton x:Name="StyleNotch" Content="Вырез-шторка от края экрана" GroupName="StyleMode"
                                                 Foreground="{DynamicResource TextPriBrush}" FontSize="13" Margin="18,0,0,0" Checked="Style_Changed"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Отображение" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Orientation="Horizontal" Margin="0,4"><ToggleButton x:Name="SwClock" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" Часы" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,4"><ToggleButton x:Name="SwSeconds" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" Секунды" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="24,4,0,4"><ToggleButton x:Name="SwWeather" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" Погода на главной" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ToggleButton x:Name="SwWeatherInIsland" Style="{StaticResource Switch}" Click="Display_Changed"/>
                                        <TextBlock Text=" Погода в игровом вырезе" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Информация о треке в островке" FontSize="14"
                                       FontWeight="SemiBold" Margin="2,12,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Мини-плеер — 325×24. При смене трека показывается карточка 325×80, затем плеер снова становится компактным."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
                                        <ToggleButton x:Name="SwReferenceTrackCard"
                                                      Style="{StaticResource Switch}"
                                                      Click="Display_Changed"/>
                                        <TextBlock Text=" Карточка трека по SVG-референсу"
                                                   FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ComboBox x:Name="TrackDisplayModeBox" Visibility="Collapsed" MinHeight="38" Padding="10,4"
                                              Background="{DynamicResource BgDeepBrush}"
                                              Foreground="{DynamicResource TextPriBrush}"
                                              BorderBrush="{DynamicResource BorderSoftBrush}"
                                              SelectionChanged="TrackDisplayMode_Changed">
                                        <ComboBox.Resources>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="{DynamicResource BgPopupBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPriBrush}"/>
                                                <Setter Property="Padding" Value="12,9"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Resources>
                                        <ComboBox.Template>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                                            CornerRadius="10"/>
                                                    <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Focusable="False" ClickMode="Press" Background="Transparent"
                                                                  BorderThickness="0" Padding="10,4">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        CornerRadius="10">
                                                                    <ContentPresenter VerticalAlignment="Center"
                                                                                      HorizontalAlignment="Stretch"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                        <Grid>
                                                            <ContentPresenter x:Name="SelectionPresenter"
                                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                              Margin="0,0,28,0"/>
                                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecBrush}"
                                                                  StrokeThickness="1.5" HorizontalAlignment="Right"
                                                                  VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        </Grid>
                                                    </ToggleButton>
                                                    <Popup x:Name="Popup" Placement="Bottom"
                                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                                           AllowsTransparency="True" Focusable="False"
                                                           PopupAnimation="Fade">
                                                        <Border Background="{DynamicResource BgPopupBrush}"
                                                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                                                BorderThickness="1" CornerRadius="10"
                                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                                          CanContentScroll="True">
                                                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ComboBox.Template>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="{DynamicResource BgPopupBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPriBrush}"/>
                                                <Setter Property="Padding" Value="12,9"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBoxItem Content="Название — исполнитель"/>
                                        <ComboBoxItem Content="Название — исполнитель и обложка"/>
                                        <ComboBoxItem Content="Обложка, название — исполнитель и эквалайзер"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Поведение" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <ToggleButton x:Name="SwTopmost" Style="{StaticResource Switch}" Click="Behavior_Changed"/>
                                        <TextBlock Text=" Поверх всех окон" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <ToggleButton x:Name="SwCollapseLoss" Style="{StaticResource Switch}" Click="Behavior_Changed"/>
                                        <TextBlock Text=" Сворачивать при потере фокуса" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <ToggleButton x:Name="SwAutostart" Style="{StaticResource Switch}" Click="Autostart_Changed"/>
                                        <TextBlock Text=" Запускать с Windows" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource ChipButton}" Content="Сбросить настройки"
                                    HorizontalAlignment="Left" Margin="2,12,0,0" Click="Reset_Click"/>
                        </StackPanel>

                        <!-- ======== Статус-бар ======== -->
                        <StackPanel x:Name="PageStats" Visibility="Collapsed">
                            <TextBlock Text="Блок на островке" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <ToggleButton x:Name="SwBattery" Style="{StaticResource Switch}" Click="Display_Changed"/>
                                        <TextBlock Text=" Батарея (всегда видна при наличии АКБ)" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <ToggleButton x:Name="SwStats" Style="{StaticResource Switch}" Click="Display_Changed"/>
                                        <TextBlock Text=" Статус-бар системы" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Метрики" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <UniformGrid Columns="3" Rows="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><ToggleButton x:Name="SwCpu" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" CPU" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><ToggleButton x:Name="SwRam" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" RAM" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4"><ToggleButton x:Name="SwGpu" Style="{StaticResource Switch}" Click="Display_Changed"/><TextBlock Text=" GPU" FontSize="13" VerticalAlignment="Center"/></StackPanel>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="Игровой режим" FontSize="14" FontWeight="SemiBold" Margin="2,12,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Тонкий вырез в играх" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Когда игра развёрнута на весь экран, островок превращается в тонкий вырез, а статус-бар показывает температуру CPU/GPU, ping и потери пакетов. Температура GPU — через nvidia-smi (только NVIDIA)."
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecBrush}" Margin="0,2,50,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SwGameMode" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Behavior_Changed"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ======== Клавиши ======== -->
                        <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                            <TextBlock Text="Развернуть / свернуть островок" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel x:Name="HotkeyList"/>
                            </Border>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14" Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Другие сочетания" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Esc — свернуть панель или закрыть настройки. Наведение курсора на островок — развернуть, убирание — свернуть. Потянуть островок вниз — тоже развернуть. Смахивание влево/вправо по панели — листание вкладок. ПКМ по островку — контекстное меню; иконка в трее — тема, статус-бар и выход."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ======== ИИ ======== -->
                        <StackPanel x:Name="PageAi" Visibility="Collapsed">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="OpenAI-совместимый API" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Используется вкладкой «ИИ-чат». Подойдёт OpenAI, OpenRouter, локальный LM Studio и т.п."
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecBrush}" Margin="0,2,0,12"/>
                                    <TextBlock Text="Base URL" FontSize="12" Foreground="{DynamicResource TextSecBrush}"/>
                                    <TextBox x:Name="ApiBaseUrlBox" Margin="0,4,0,10" LostFocus="Ai_Save"/>
                                    <TextBlock Text="API key" FontSize="12" Foreground="{DynamicResource TextSecBrush}"/>
                                    <PasswordBox x:Name="ApiKeyBox" Margin="0,4,0,10" LostFocus="Ai_Save"/>
                                    <TextBlock Text="Модель" FontSize="12" Foreground="{DynamicResource TextSecBrush}"/>
                                    <TextBox x:Name="ApiModelBox" Margin="0,4,0,0" LostFocus="Ai_Save"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ======== Модули ======== -->
                        <StackPanel x:Name="PageStore" Visibility="Collapsed">
                            <views:WidgetStorePanel/>
                        </StackPanel>

                        <!-- ======== Обновления ======== -->
                        <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdatesVersionText" Text="Версия 0.0.1" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Проверять новые версии при запуске" FontSize="12"
                                                   Foreground="{DynamicResource TextSecBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SwUpdates" Style="{StaticResource Switch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Click="Updates_Changed"/>
                                </Grid>
                            </Border>
                            <Button Style="{StaticResource ChipButton}" Content="Проверить сейчас"
                                    HorizontalAlignment="Left" Margin="2,10,0,12" Click="CheckNow_Click"/>

                            <TextBlock Text="Что нового" FontSize="14" FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <Border Background="{DynamicResource BgCardBrush}" CornerRadius="14" Padding="14"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <StackPanel x:Name="ChangelogPanel">
                                    <TextBlock Text="Версия 0.0.1" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,10" TextWrapping="Wrap"
