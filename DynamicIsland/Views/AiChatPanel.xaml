<UserControl x:Class="DynamicIsland.Views.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="142"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0,0,12,0" Background="{DynamicResource BgCardBrush}"
                CornerRadius="18" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
            <Grid>
                <Ellipse Width="74" Height="74" Stroke="{DynamicResource BorderSoftBrush}" StrokeThickness="1"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,38,0,0"/>
                <Ellipse Width="52" Height="52" Stroke="{DynamicResource AccentSecondaryBrush}" StrokeThickness="1"
                         Opacity="0.2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,49,0,0"/>
                <Path Style="{StaticResource VecIcon}" Width="23" Height="23" Data="{StaticResource ic_bot}"
                      Fill="{DynamicResource AccentTertiaryBrush}" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Margin="0,63,0,0" Opacity="0.45"/>
                <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,16">
                    <TextBlock Text="AURA" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Место для 3D-компаньона" FontSize="9" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource VecIcon}" Width="15" Height="15" Data="{StaticResource ic_bot}" Margin="0,0,6,0"/>
                    <TextBlock Text="ИИ-чат" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Click="ToggleApiSettings">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource VecIcon}" Width="12" Height="12" Data="{StaticResource ic_settings}" Margin="0,0,5,0"/>
                        <TextBlock Text="API" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="ApiSettings" Background="{DynamicResource BgCardBrush}" CornerRadius="12" Padding="10"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,8"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="108"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Base URL" FontSize="11" Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ApiBaseUrlBox" Grid.Column="1" Grid.ColumnSpan="3" Margin="6,0,0,6"/>
                    <TextBlock Text="API key" Grid.Row="1" FontSize="11" Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="6,0,6,0"/>
                    <TextBlock Text="Модель" Grid.Row="1" Grid.Column="2" FontSize="11" Foreground="{DynamicResource TextSecBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="ApiModelBox" Grid.Row="1" Grid.Column="3" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="2">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="100"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="Input_KeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource CardButton}" Content="Отправить"
                        Margin="8,0,0,0" Padding="16,8" Click="Send_Click"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
